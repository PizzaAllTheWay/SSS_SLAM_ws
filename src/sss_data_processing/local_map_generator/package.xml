<package format="3">
  <name>local_map_generator</name>
  <version>1.0.0</version>
  <description>Local Map Generator for the Side Scan Sonar SLAM pipeline</description>
  <maintainer email="karate.martynas1@gmail.com">Martynas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rcl</depend>
  <depend>marine_acoustic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>